{
  "name": "@captain-sdk/captain-mcp",
  "version": "0.8.2",
  "description": "MCP server for Captain \u2014 multimodal RAG search, chunk management, and live project search. Usable from Claude Code, Cursor, and any MCP-aware client. Runs over stdio (local) or Streamable HTTP (hosted).",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/runcaptain/captain-mcp"
  },
  "keywords": [
    "mcp",
    "captain",
    "rag",
    "search",
    "multimodal",
    "claude-code",
    "cursor"
  ],
  "bin": {
    "captain-mcp": "./dist/server.js"
  },
  "main": "./dist/server.js",
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc",
    "test": "npm run build && node --test scripts/test-query-timing.mjs scripts/test-eval-api-tools.mjs scripts/test-inline-file-validation.mjs",
    "start": "node dist/server.js",
    "start:http": "node dist/httpServer.js",
    "dev": "tsc --watch",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "express": "^5.2.1",
    "jose": "^6.1.3",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/node": "^22.0.0",
    "typescript": "^5.6.0"
  },
  "engines": {
    "node": ">=18"
  }
}
